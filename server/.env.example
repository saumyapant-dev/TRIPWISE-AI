# TripWise AI - Backend Environment Configuration Template
# Store your private API keys securely here. Never commit real credentials.

# Server Port (default: 5001)
PORT=5001

# Google Gemini API Key (for dynamic AI itinerary generation and concierge chat)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Unsplash Access Key (optional, for destination hero images)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# SQLite Database Storage Location
DATABASE_PATH=./src/data/tripwise.db
